              </a>
            </div>
          </article>


          <!-- Older / Newer navigation -->
          <nav
            class="d-flex justify-content-between border-top pt-4"
            aria-label="Publication navigation"
          >
            <a
              href="#"
              class="btn btn-outline-secondary"
            >
              ← Older
            </a>

            <a
              href="#"
              class="btn btn-outline-secondary"
            >
              Newer →
            </a>
          </nav>

        </div>
      </div>
    </div>
  </Fragment>
</SingleLayout>