---
import SingleLayout from '@layouts/SingleLayout.astro'
import { getConfig } from '@libs/config'

export function getStaticPaths() {
  return [
    {
      params: { version: getConfig().docs_version }
    }
  ]
}
---

<SingleLayout
  title="Qonstruct Papers & Tutorials"
  description="Research papers, tutorials and presentations from Qonstruct."
>
  <Fragment slot="main-content">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">

          <!-- QUANCOM 2026 - Paper -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              QUANCOM 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Paper · To be published
            </p>

            <p>
              QUANCOM 2026 presents a collaborative low-code approach
              to quantum computing. The work explores how users with
              different levels of expertise can collaborate within a
              shared environment.
            </p>

            <p>
              The approach aims to reduce the steep learning curve of
              quantum computing by providing accessible abstractions
              and a common workspace. This enables users to exchange
              knowledge and collaborate while developing quantum
              computing solutions.
            </p>

            <p>
              The paper discusses how such an environment can support
              collaboration between team members with different
              backgrounds and levels of expertise.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <button
                type="button"
                class="btn btn-outline-primary"
                disabled
              >
                Paper to be published
              </button>

              <a href="#" class="btn btn-outline-secondary">
                Slides
              </a>
            </div>
          </article>


          <!-- QUANTICS 2026 - Paper -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              QUANTICS 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Paper · To be published
            </p>

            <p>
              QUANTICS 2026 investigates approaches for making quantum
              application development more accessible to domain experts.
            </p>

            <p>
              The work introduces the concepts of
              <strong>domain blocks</strong> and
              <strong>domain profiles</strong>, allowing domain experts
              to describe problems using concepts and terminology from
              their own domain rather than low-level quantum constructs.
            </p>

            <p>
              The approach further explores AI-assisted support for
              selecting and composing suitable quantum algorithms and
              services based on domain-specific problem descriptions.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <button
                type="button"
                class="btn btn-outline-primary"
                disabled
              >
                Paper to be published
              </button>

              <a href="#" class="btn btn-outline-secondary">
                Slides
              </a>
            </div>
          </article>


          <!-- ICSOFT 2026 - Paper -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              ICSOFT 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Paper
            </p>

            <p>
              Research paper presented at ICSOFT 2026.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <a href="#" class="btn btn-outline-primary">
                Read paper
              </a>

              <a href="#" class="btn btn-outline-secondary">
                Slides
              </a>
            </div>
          </article>


          <!-- QUANTICS 2026 - Tutorial -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              QUANTICS 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Tutorial
            </p>

            <p>
              Tutorial presented at QUANTICS 2026.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <a href="#" class="btn btn-outline-primary">
                View tutorial
              </a>

              <a href="#" class="btn btn-outline-secondary">
                Slides
              </a>
            </div>
          </article>


          <!-- ICSOFT 2026 - Tutorial -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              ICSOFT 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Tutorial
            </p>

            <p>
              Tutorial presented at ICSOFT 2026.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <a href="#" class="btn btn-outline-primary">
                View tutorial
              </a>

              <a href="#" class="btn btn-outline-secondary">
                Slides
              </a>
            </div>
          </article>


          <!-- DH 2026 - Paper -->
          <article class="blog-post mb-5 pb-5 border-bottom">
            <h1 class="display-5 fw-bold mb-3">
              DH 2026
            </h1>

            <p class="text-body-secondary mb-4">
              Paper
            </p>

            <p>
              Research paper presented at DH 2026.
            </p>

            <div class="mt-4 d-flex flex-wrap gap-2">
              <a href="#" class="btn btn-outline-primary">
                Read paper
              </a>

              <a href="#" class="btn btn-outline-secondary">
